# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real values.

# Canonical origin (optional). Drives canonical tags, OG/Twitter URLs,
# sitemap.xml and robots.txt. Unset, it falls back to https://ianriley.co (see
# src/data/site.ts), which is what production uses — so leave it commented out
# unless you need metadata to point at a different origin.
# NEXT_PUBLIC_SITE_URL=https://ianriley.co

# Web3Forms access key for the contact form.
# Get a free key at https://web3forms.com (enter your email, they email you a key).
# This key is PUBLIC by design — it only lets the form send to your mailbox, it
# cannot read submissions — so the NEXT_PUBLIC_ prefix (shipped to the browser)
# is correct. If unset, the contact form runs in safe demo mode.
NEXT_PUBLIC_WEB3FORMS_KEY=
